# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# Nenhum valor real/sensivel deve ser commitado em ".env".

# Banco de dados
DB_DRIVER=mysql
DB_HOST=localhost
DB_DATABASE=bancotestenfse
DB_USERNAME=root
DB_PASSWORD=

# Ambiente do webservice de NFS-e: homologacao ou producao
NFSE_AMBIENTE=homologacao

# URLs de homologacao (padrao de teste do municipio de Nova Prata/RS)
NFSE_URL_ENVIO_HOMOLOGACAO=http://homologaprata.nfse-tecnos.com.br:9091
NFSE_URL_CANCELAR_HOMOLOGACAO=http://homologaprata.nfse-tecnos.com.br:9098
NFSE_URL_CONSULTALOTE_HOMOLOGACAO=http://homologaprata.nfse-tecnos.com.br:9097

# URLs de producao
NFSE_URL_ENVIO_PRODUCAO=http://novaprata.nfse-tecnos.com.br:9091
NFSE_URL_CANCELAR_PRODUCAO=http://novaprata.nfse-tecnos.com.br:9098
NFSE_URL_CONSULTALOTE_PRODUCAO=http://novaprata.nfse-tecnos.com.br:9097

# URL de consulta de NFS-e: identica em homologacao e producao
NFSE_URL_CONSULTA=http://novaprata.nfse-tecnos.com.br:9084
