{
    "name": "novaprata/nfse",
    "description": "Emissao, cancelamento e consulta de NFS-e (padrao ABRASF) para o municipio de Nova Prata/RS",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "NovaPrata\\Nfse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NovaPrata\\Nfse\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR12 src",
        "cs-fix": "phpcbf --standard=PSR12 src"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
